import express from "express";
import { createServer as createViteServer } from "vite";
import path from "path";
import dotenv from "dotenv";
import mysql from "mysql2/promise";

dotenv.config();

/**
 * EXEMPLE DE SERVEUR EXPRESS AVEC BASE DE DONNÉES MARIADB/MYSQL
 * -----------------------------------------------------------
 * Ce fichier montre comment transformer vos appels Firestore
 * (getDoc, addDoc, updateDoc, onSnapshot) en routes API SQL.
 * 
 * 1. Renommez ce fichier en `server.ts` pour remplacer la version Firebase
 * 2. Côté client React, remplacez `setDoc(...)` par `fetch('/api/users', { method: 'POST' ... })`
 */

async function startServer() {
  const app = express();
  const PORT = 3005;

  app.use(express.json());

  // Permettre les requêtes CORS
  app.use((req, res, next) => {
    res.header("Access-Control-Allow-Origin", "*");
    res.header("Access-Control-Allow-Headers", "Origin, X-Requested-With, Content-Type, Accept, Authorization");
    if (req.method === 'OPTIONS') {
        res.header('Access-Control-Allow-Methods', 'PUT, POST, PATCH, DELETE, GET');
        return res.status(200).json({});
    }
    next();
  });

  // ==========================================
  // 1. CONFIGURATION DE LA BASE DE DONNÉES
  // ==========================================
  const pool = mysql.createPool({
    host: process.env.DB_HOST || 'localhost',
    user: process.env.DB_USER || 'livra_user',
    password: process.env.DB_PASS || 'password',
    database: process.env.DB_NAME || 'livra_express',
    waitForConnections: true,
    connectionLimit: 10,
    queueLimit: 0
  });

  // ==========================================
  // 2. EXEMPLES D'API POUR LA TABLE "users"
  // (Remplace `getDoc(doc(db, 'users', id))` et `setDoc()`)
  // ==========================================

  // Récupérer un utilisateur complet
  app.get("/api/users/:id", async (req, res) => {
    try {
      const [rows]: any = await pool.query('SELECT * FROM users WHERE userId = ?', [req.params.id]);
      if (rows.length === 0) return res.status(404).json({ error: "User not found" });
      res.json(rows[0]);
    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

  // Créer ou mettre à jour un utilisateur (Remplace `setDoc(..., { merge: true })`)
  app.post("/api/users", async (req, res) => {
    try {
      const { userId, name, email, role } = req.body;
      const query = `
        INSERT INTO users (userId, name, email, role) 
        VALUES (?, ?, ?, ?)
        ON DUPLICATE KEY UPDATE 
        name = VALUES(name), email = VALUES(email), role = VALUES(role), updatedAt = NOW()
      `;
      await pool.query(query, [userId, name, email, role || 'client']);
      res.json({ success: true, message: "User saved successfully" });
    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

  app.patch("/api/users/:id", async (req, res) => {
    try {
      // Pour une simple mise à jour de champ (Remplace `updateDoc(...)`)
      const { status } = req.body;
      await pool.query('UPDATE users SET status = ?, updatedAt = NOW() WHERE userId = ?', [status, req.params.id]);
      res.json({ success: true });
    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

  // ==========================================
  // 3. EXEMPLES D'API POUR LA TABLE "deliveries"
  // (Remplace `getDocs(collection(...))` et `addDoc()`)
  // ==========================================

  // Lister les livraisons avec des filtres (Remplace `query(collection(), where(...))`)
  app.get("/api/deliveries", async (req, res) => {
    try {
      const status = req.query.status; // ex: '?status=pending'
      const driverId = req.query.driverId; // ex: '?driverId=123'
      
      let q = 'SELECT * FROM deliveries WHERE 1=1';
      let params = [];
      
      if (status) {
        q += ' AND status = ?';
        params.push(status);
      }
      if (driverId) {
        q += ' AND driverId = ?';
        params.push(driverId);
      }
      
      q += ' ORDER BY createdAt DESC LIMIT 50';

      const [rows] = await pool.query(q, params);
      res.json(rows);
    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

  // Créer une livraison (Remplace `addDoc(collection(...))`)
  app.post("/api/deliveries", async (req, res) => {
    try {
      // Générer ou recevoir un ID unique (uuid v4 par exemple)
      const deliveryId = req.body.id || 'del_' + Date.now(); 
      const { clientId, fromLat, fromLng, fromAddress, toLat, toLng, toAddress, cost } = req.body;
      
      const query = `
        INSERT INTO deliveries 
        (id, clientId, fromLat, fromLng, fromAddress, toLat, toLng, toAddress, cost) 
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
      `;
      await pool.query(query, [deliveryId, clientId, fromLat, fromLng, fromAddress, toLat, toLng, toAddress, cost]);
      
      res.json({ success: true, id: deliveryId });
    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

  // Mettre à jour le statut d'une livraison (Remplace `updateDoc(doc(...))`)
  app.patch("/api/deliveries/:id/status", async (req, res) => {
    try {
      const { status, driverId } = req.body;
      let query = 'UPDATE deliveries SET status = ?, updatedAt = NOW()';
      let params: any[] = [status];
      
      if (driverId) {
        query += ', driverId = ?';
        params.push(driverId);
      }
      
      query += ' WHERE id = ?';
      params.push(req.params.id);
      
      await pool.query(query, params);
      res.json({ success: true });
    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

  // ==========================================
  // CONFIGURATION VITE (Pour le frontend)
  // ==========================================
  if (process.env.NODE_ENV !== "production") {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    // Mode Production
    const distPath = path.join(process.cwd(), "dist");
    app.use(express.static(distPath));
    app.get("*", (req, res) => {
      res.sendFile(path.join(distPath, "index.html"));
    });
  }

  app.listen(PORT, "0.0.0.0", () => {
    console.log(`Serveur Local API + Serveur de fichiers démarré sur le port ${PORT}`);
  });
}

startServer();
